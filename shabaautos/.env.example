# ShabaAutos environment template. Copy to .env and fill in real values..env is gitignored.

# Clerk (backend)
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=your_clerk_webhook_signing_secret

# Clerk (frontend)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Neon Postgres
DATABASE_URL=postgresql://user:pass@host/db

# GROQ AI (optional but enabled)
GROQ_API_KEY=your_groq_api_key
AI_FEATURES_ENABLED=true
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudinary (optional, used when allthree keyss are set; else falls back to local /uploads disk storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Uploads (local fallback)
UPLOADS_DIR=./uploads

# API base for the built frontend (set to Vercel/Fly URL in production)
VITE_API_BASE_URL=http://localhost:3000

# CORS (comma-separated origins) — add your Vercel frontend in production
CORS_ALLOWED_ORIGINS=http://localhost:3000

# First-party analytics (real collected events only; no fabricated numbers)
ACTIVITY_TRACKING=true
ANALYTICS_STORE_IP_HASH=false
ANALYTICS_STORE_USER_AGENT=false

# Import estimator defaults (used only if the rate is not yet in site_settings;
# once seeded, the admin Settings UI is the authoritative override)
IMPORT_USD_TO_NGN_RATE=1500
IMPORT_FREIGHT_DEFAULT_USD=1800
IMPORT_FREIGHT_HOUSTON_USD=1950
IMPORT_INLAND_TOWING_USD=450
IMPORT_TERMINAL_CHARGES_NGN=380000
IMPORT_CLEARING_FEE_NGN=450000
IMPORT_DUTY_RATE=0.35
IMPORT_DUTY_RATE_EV=0.10
IMPORT_LEVY_RATE=0.15
IMPORT_LEVY_RATE_EV=0.05
IMPORT_VAT_RATE=0.075
RENTAL_CHAUFFEUR_FEE_DAY_NGN=25000
RENTAL_INSURANCE_FEE_DAY_NGN=10000