 # Server configuration
PORT=3000
NODE_ENV=development

# Database configuration (USE_SQLITE=true by default for zero-dependency local SQLite storage)
USE_SQLITE=true
DATABASE_URL=
DATABASE_PATH=

# Development and Demo Mode
DEMO_MODE=true
SEED_DATABASE=false

# Authentication (Clerk)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# AI Features (Server-side)
GEMINI_API_KEY=
GROQ_API_KEY=
AI_FEATURES_ENABLED=false
