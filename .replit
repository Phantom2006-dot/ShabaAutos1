modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ShabaAutos Preview"

[[workflows.workflow]]
name = "ShabaAutos Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd shabaautos && USE_SQLITE=true DEMO_MODE=true NODE_ENV=development PORT=3000 npm run dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
